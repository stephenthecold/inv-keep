# ---- Required ----
# SQLite file inside the mounted ./data volume
DATABASE_URL=sqlite:////code/data/app.db
# Used to sign the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-generate-a-random-value

# ---- Deployment: hostname / port / SSL ----
# Public hostname (used by the SSL proxy and for OIDC redirect URLs).
HOSTNAME=localhost
# Host port for direct (non-SSL) access -> http://localhost:APP_PORT
APP_PORT=8000
# Email used by Let's Encrypt when the SSL proxy is enabled.
ACME_EMAIL=admin@example.com
# Which Caddy config the bundled proxy uses:
#   ./Caddyfile          -> automatic Let's Encrypt certificates (default)
#   ./Caddyfile.custom   -> YOUR OWN cert at certs/cert.pem + certs/key.pem
CADDY_CONFIG=./Caddyfile
# Enable the bundled HTTPS proxy with the ssl profile:
#   docker compose --profile ssl up -d --build
# Or omit it and put Inv-Keep behind your OWN reverse proxy (expose APP_PORT and
# forward X-Forwarded-Proto: https). See docs/DEPLOY.md.

# ---- Image pin (optional) ----
# docker-compose.yml pulls ghcr.io/stephenthecold/inv-keep:${INV_KEEP_VERSION:-latest}.
# Uncomment and pin to a specific tag if you don't want `latest` floating:
# INV_KEEP_VERSION=v1.12.0

# ---- Break-glass ----
# If set to 1/true, ALL authentication is bypassed regardless of UI settings.
# DISABLE_AUTH=1

# ---- Optional first-run seeds ----
# Everything below is configured in the UI (Settings) and stored in the database.
# These env vars only SEED the defaults on the first run with an empty database.
# APP_TITLE=Inv-Keep
# CURRENCY=$
# AUTH_MODE=none                # none | oidc | forward
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=            # e.g. https://HOSTNAME/auth/callback
# FORWARD_AUTH_USER_HEADER=x-authentik-username
# FORWARD_AUTH_EMAIL_HEADER=x-authentik-email
