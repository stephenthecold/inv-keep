# ---- Required ----
# SQLite file inside the mounted ./data volume
DATABASE_URL=sqlite:////code/data/app.db
# Used to sign the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-generate-a-random-value

# ---- Break-glass ----
# If set to 1/true, ALL authentication is bypassed regardless of the in-app
# settings. Use this to recover access if an OIDC misconfiguration locks you out,
# then unset it once you've fixed the settings in the UI.
# DISABLE_AUTH=1

# ---- Optional first-run seeds ----
# Everything below is now configured in the UI (Settings) and stored in the
# database. These env vars are only used to SEED the defaults on the very first
# run with an empty database; after that, edit them under Settings instead.
# APP_TITLE=Inv-Keep
# CURRENCY=$
# AUTH_MODE=none                # none | oidc | forward
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=
# FORWARD_AUTH_USER_HEADER=x-authentik-username
# FORWARD_AUTH_EMAIL_HEADER=x-authentik-email
